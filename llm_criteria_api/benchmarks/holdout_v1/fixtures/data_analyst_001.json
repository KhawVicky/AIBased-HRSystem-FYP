  "referenceJd": {
    "jobTitle": "Data Analyst",
    "department": "Business Intelligence",
    "description": "Turn reliable operational data into clear analysis, dashboards and recommendations for business decision-making.",
    "qualifications": [
      {"id": "Q1", "text": "Bachelor's Degree in Statistics, Mathematics, Data Science, Computer Science or a related quantitative field."}
    ],
    "responsibilities": [
      {"id": "R1", "text": "Gather and validate data from operational systems, databases and approved external sources."},
      {"id": "R2", "text": "Clean and transform datasets, resolve data-quality issues and document repeatable validation rules."},
      {"id": "R3", "text": "Write SQL queries and build reusable analytical datasets for reporting and investigation."},
      {"id": "R4", "text": "Develop Power BI dashboards and KPI reports with clear definitions and drill-down views."},
      {"id": "R5", "text": "Perform statistical analysis to identify trends, anomalies and actionable business insights."},
      {"id": "R6", "text": "Translate stakeholder questions into analytical requirements and present evidence-based recommendations."},
      {"id": "R7", "text": "Automate recurring data preparation and reporting tasks using Python."},
      {"id": "R8", "text": "Maintain data dictionaries and follow approved data-access and confidentiality controls."},
      {"id": "R9", "text": "Collaborate with team members on other assigned activities."}
    ],
    "requirements": [
      {"id": "Q2", "text": "Minimum 2 years of data analysis or business reporting experience."},
      {"id": "Q3", "text": "Advanced SQL skills are required."},
      {"id": "Q4", "text": "Hands-on experience with Power BI or Tableau is required."},
      {"id": "Q5", "text": "Experience using Python for data analysis or automation is preferred."}
    ]
  },
