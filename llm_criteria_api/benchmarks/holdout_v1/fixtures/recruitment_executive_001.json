{
  "benchmarkId": "holdout-recruitment-executive-001",
  "jobFamily": "talent_acquisition",
  "referenceJd": {
    "jobTitle": "Recruitment Executive",
    "department": "Human Resources",
    "description": "Manage practical recruitment activities from vacancy intake through offer preparation while maintaining an accurate and respectful candidate process.",
    "qualifications": [
      {"id": "Q1", "text": "Diploma or Bachelor's Degree in Human Resources, Business Administration, Psychology or a related field."}
    ],
    "responsibilities": [
      {"id": "R1", "text": "Partner with hiring managers to clarify vacancy requirements, prepare job descriptions and agree recruitment plans."},
      {"id": "R2", "text": "Source candidates through job portals, professional networks, employee referrals and targeted outreach."},
      {"id": "R3", "text": "Screen applications and conduct structured phone interviews against the approved job requirements."},
      {"id": "R4", "text": "Schedule interviews, coordinate interview panels and keep candidates informed throughout the selection process."},
      {"id": "R5", "text": "Prepare offer documents and coordinate reference checks and other pre-employment checks."},
      {"id": "R6", "text": "Maintain accurate applicant tracking system records and produce recruitment pipeline and time-to-fill reports."},
      {"id": "R7", "text": "Support employer-branding campaigns, university engagement and career-fair activities."},
      {"id": "R8", "text": "Provide complete candidate and joining information to the onboarding team after offer acceptance."},
      {"id": "R9", "text": "Perform other duties assigned by the HR Manager from time to time."}
    ],
    "requirements": [
      {"id": "Q2", "text": "Minimum 2 years of recruitment or talent acquisition experience."},
      {"id": "Q3", "text": "Experience using an applicant tracking system and online job portals is preferred."},
      {"id": "Q4", "text": "Strong interpersonal and written communication skills."},
      {"id": "Q5", "text": "Working knowledge of Malaysian employment legislation and fair hiring practices."}
    ]
  },
