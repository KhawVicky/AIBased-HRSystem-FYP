{
  "benchmarkId": "holdout-production-supervisor-001",
  "jobFamily": "manufacturing_operations",
  "referenceJd": {
    "jobTitle": "Production Supervisor",
    "department": "Manufacturing",
    "description": "Lead safe and reliable shift execution while coordinating people, materials, quality and equipment to meet daily production commitments.",
    "qualifications": [
      {"id": "Q1", "text": "Diploma in Manufacturing, Mechanical Engineering, Industrial Engineering or a related technical field."}
    ],
    "responsibilities": [
      {"id": "R1", "text": "Plan the shift production schedule and assign operators and workstations to meet daily output targets."},
      {"id": "R2", "text": "Monitor output, cycle time and downtime and respond promptly to production delays."},
      {"id": "R3", "text": "Enforce standard work, operating procedures, 5S and workplace safety requirements."},
      {"id": "R4", "text": "Conduct shift briefings, coach operators and manage attendance and performance issues."},
      {"id": "R5", "text": "Coordinate with Quality to contain defects, investigate production nonconformances and implement corrective actions."},
      {"id": "R6", "text": "Coordinate equipment breakdown response and preventive-maintenance activities with the Maintenance team."},
      {"id": "R7", "text": "Control raw-material and work-in-progress flow and maintain accurate production records."},
      {"id": "R8", "text": "Complete shift handovers with clear production status, downtime and unresolved-issue information."},
      {"id": "R9", "text": "Lead continuous-improvement activities to reduce waste and improve process efficiency."},
      {"id": "R10", "text": "Perform other tasks assigned by the Production Manager."}
    ],
    "requirements": [
      {"id": "Q2", "text": "Minimum 3 years of manufacturing production experience, including at least 1 year in a supervisory role."},
      {"id": "Q3", "text": "Knowledge of lean manufacturing, OEE and structured problem-solving methods is preferred."},
      {"id": "Q4", "text": "Willingness to work rotating shifts is required."}
    ]
  },
