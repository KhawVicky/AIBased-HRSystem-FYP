    ],
    "responsibilities": [
      {"id": "R1", "text": "Process supplier invoices and credit notes and verify supporting documents."},
      {"id": "R2", "text": "Perform three-way matching between purchase orders, goods received notes and supplier invoices."},
      {"id": "R3", "text": "Code accounts payable transactions to the correct general ledger accounts, cost centres and projects."},
      {"id": "R4", "text": "Reconcile supplier statements and resolve invoice or payment discrepancies."},
      {"id": "R5", "text": "Prepare payment runs and ensure approved supplier payments are completed by their due dates."},
      {"id": "R6", "text": "Support month-end closing, AP ageing review, accruals and accounts payable reporting."},
      {"id": "R7", "text": "Respond to vendor enquiries and provide documents required for internal and external audits."},
      {"id": "R8", "text": "Support Malaysia e-Invoice requirements and relevant tax documentation."},
      {"id": "R9", "text": "Perform other tasks assigned by the Finance Manager."}
    ],
    "requirements": [
      {"id": "Q2", "text": "Minimum 2 years of accounts payable experience."},
      {"id": "Q3", "text": "Experience using an ERP accounting system such as SAP or Oracle is preferred."},
      {"id": "Q4", "text": "Must be responsible, accurate and able to work independently."}
    ]
  },
