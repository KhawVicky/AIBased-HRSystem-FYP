      {"id": "R1", "text": "Manage and supervise end-to-end HR operations, including recruitment, onboarding, training, performance management and payroll coordination."},
      {"id": "R2", "text": "Manage employee relations, counselling, disciplinary cases and grievance handling in accordance with company procedures."},
      {"id": "R3", "text": "Manage the recruitment and administration of foreign workers and expatriates."},
      {"id": "R4", "text": "Coordinate foreign-worker quotas, work permits, immigration documentation, hostel arrangements, transportation, renewals and departure processes."},
      {"id": "R5", "text": "Ensure HR practices comply with Malaysian labour laws and employment regulations."},
      {"id": "R6", "text": "Develop and review HR policies, departmental SOPs and records required for ISO audits."},
      {"id": "R7", "text": "Prepare workforce reports and advise management on HR matters."},
      {"id": "R8", "text": "Coordinate security guards and ensure employee access-control arrangements are maintained."},
      {"id": "R9", "text": "Perform any other duties assigned by management."}
    ],
    "requirements": [
      {"id": "Q2", "text": "Minimum 5 years of experience in the HR field, including supervisory responsibilities."},
      {"id": "Q3", "text": "Experience working in a manufacturing environment is preferred."},
      {"id": "Q4", "text": "Good communication, leadership and interpersonal skills."}
    ]
  },
