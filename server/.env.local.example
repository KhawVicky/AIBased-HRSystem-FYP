# Copy this file to server/.env.local for the local HR API.
# Use Railway's public TCP proxy host and port for a local connection.
DB_HOST=your-railway-public-host
DB_PORT=your-railway-public-port
DB_USER=root
DB_PASSWORD=your-railway-password
DB_NAME=railway
DB_SSL_VERIFY=false

API_SURFACE=full
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave blank locally so URLs use the local Apache host automatically.
PUBLIC_API_BASE_URL=

# SMTP settings for hosted email delivery. Keep the password in the deployment
# environment, not in tracked files. The local mail-config.local.php file is
# used when these variables are not provided.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_ENCRYPTION=tls
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=UWC Recruitment
# SMTP_VERIFY_PEER=true

# RunPod Serverless JD criteria proxy for the Railway HR API service.
# These variables belong on the Railway hr-api service, not the frontend.
# The endpoint URL uses the RunPod Serverless endpoint ID, not the Docker image name.
# Restart or redeploy hr-api after changing these values.
RUNPOD_CRITERIA_ENDPOINT_URL=https://api.runpod.ai/v2/your-endpoint-id/runsync
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_CRITERIA_TIMEOUT_SECONDS=240

# The parsing-service can reuse the same endpoint and key by receiving
# RUNPOD_CRITERIA_ENDPOINT_URL and RUNPOD_API_KEY in its own environment.
# Set RESUME_QWEN_ENDPOINT_URL / RESUME_QWEN_API_KEY only for an override.
# A RunPod URL is auto-detected by the parser; RESUME_QWEN_PROTOCOL=runpod is
# also accepted explicitly.

# Optional internal FastAPI resume parser callback for saved application PDFs.
RESUME_PARSING_API_URL=http://127.0.0.1:8001/api/resume/parse
RESUME_PARSING_TIMEOUT_SECONDS=120
RESUME_REQUIRE_SEMANTIC=true

# Candidate scoring callback. When omitted, the PHP integration derives the
# /api/scoring/candidate route from RESUME_PARSING_API_URL.
CANDIDATE_SCORING_API_URL=http://127.0.0.1:8001/api/scoring/candidate
CANDIDATE_SCORING_TIMEOUT_SECONDS=240
